# OS
.DS_Store
Thumbs.db

# Editor
.vscode/extensions.json

# Team-Kollaboration: Nextcloud-Symlinks und extern synchronisierte Ordner
input/data-shared
input/data-nextcloud

# Large data files (track with Git LFS or exclude)
input/data/**/*.tif
input/data/**/*.shp
input/data/**/*.dbf
input/data/**/*.shx
input/data/**/*.prj
input/data/**/*.gpkg
*.sqlite

# Output build artifacts
output/**/_output/
output/**/_site/
output/**/_book/
output/**/.quarto/
output/**/*.tex
output/**/*.log
output/**/*.aux
output/presentation/_output/
output/presentation/.quarto/
output/presentation/*.tex
output/presentation/*.log
output/presentation/*.aux
output/presentation/*.nav
output/presentation/*.snm
output/presentation/*.toc
output/presentation/*.vrb

# ...but keep the hand-authored preamble sources (referenced via
# include-in-header). Only Quarto-generated .tex are build artifacts.
!output/**/_preamble.tex

# CI/CD
public/

output/data-analysis/__pycache__/
output/data-analysis/.ipynb_checkpoints/
output/app/__pycache__/
output/app/venv/
output/app/node_modules/

# Generated knowledge-graph export (scripts/wiki-to-graph.py)
knowledge/_meta/graph/

# Keep directory structure
!**/.gitkeep
